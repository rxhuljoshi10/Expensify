{
  "expo": {
    "name": "Expensify",
    "slug": "expensify",
    "scheme": "expensify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splashscreen.png",
      "resizeMode": "contain",
      "backgroundColor": "#6C63FF"
    },
    "ios": {
      "supportsTablet": true,
      "package": "com.package.expensify",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "android": {
      "package": "com.rxhuljoshi.expensify",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6C63FF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Expensify needs camera access to scan bills and receipts.",
          "photosPermission": "Expensify needs photo access to scan bills from your gallery."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6C63FF",
          "sounds": []
        }
      ],
      "expo-web-browser",
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dbfa44d7-75d1-4900-88d2-e6cc285479d6"
      }
    }
  }
}
